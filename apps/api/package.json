    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "prisma": "6.18.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
