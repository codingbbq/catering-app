generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  onboarding
  active
  suspended
  archived
}

enum AuditLogScope {
  platform
  tenant
}

enum AuditLogOutcome {
  allowed
  denied
}

model Tenant {
  id          String          @id @default(uuid())
  slug        String          @unique
  displayName String
  status      TenantStatus    @default(onboarding)
  settings    TenantSettings?
  users       TenantUser[]
  invitations UserInvitation[]
  customers   Customer[]
  enquiries   Enquiry[]
  catalogueItems CatalogueItem[]
  catalogueImports CatalogueImportJob[]
  menus       Menu[]
  recipes     Recipe[]
  costSheets  CostSheet[]
  quotations  Quotation[]
  bookings    Booking[]
  communicationLogs CommunicationLog[]
  communicationTemplates CommunicationTemplate[]
  invoices          Invoice[]
  invoicePayments   InvoicePayment[]
  payments          Payment[]
  paymentAllocations PaymentAllocation[]
  auditLogs   AuditLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TenantSettings {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  timezone     String   @default("UTC")
  currencyCode String   @default("USD")
  locale       String   @default("en")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PlatformRole {
  super_admin
  platform_ops
}

enum TenantRole {
  owner
  admin
  manager
  staff
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  displayName  String
  role         PlatformRole @default(platform_ops)
  isActive     Boolean      @default(true)
  sessions     Session[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model TenantUser {
  id              String      @id @default(uuid())
  email           String
  passwordHash    String
  displayName     String
  role            TenantRole  @default(staff)
  isActive        Boolean     @default(true)
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions        Session[]
  assignedEnquiries Enquiry[]
  catalogueImports CatalogueImportJob[]
  invitedBy       String?
  resetToken      String?     @unique
  resetTokenExpiry DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([email, tenantId])
  @@index([tenantId])
}

model UserInvitation {
  id        String           @id @default(uuid())
  email     String
  token     String           @unique
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      TenantRole       @default(staff)
  status    InvitationStatus @default(pending)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
  @@index([token])
}

model Session {
  id             String        @id @default(uuid())
  refreshToken   String        @unique
  scope          AuditLogScope
  platformUserId String?
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tenantUserId   String?
  tenantUser     TenantUser?   @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  tenantId       String?
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  @@index([platformUserId])
  @@index([tenantUserId])
  @@index([expiresAt])
}

model AuditLog {
  id        String          @id @default(uuid())
  scope     AuditLogScope
  outcome   AuditLogOutcome
  tenantId  String?
  action    String
  actorType String
  reason    String?
  metadata  Json?
  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([scope, tenantId, createdAt])
}

// --- CRM-001: Customer Management ---

model Customer {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean           @default(true)
  contacts    CustomerContact[]
  enquiries   Enquiry[]
  bookings    Booking[]
  invoices    Invoice[]
  payments    Payment[]
  communicationLogs CommunicationLog[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, email])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}


// --- CRM-002: Enquiry Management ---

enum EnquiryStatus {
  new
  qualified
  proposal_sent
  converted
  lost
  cancelled
}

enum ServiceType {
  event_catering
  daily_meals
  other
}

enum ActivityType {
  note
  call
  email
  meeting
  status_change
}

model Enquiry {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title           String
  status          EnquiryStatus     @default(new)
  serviceType     ServiceType       @default(event_catering)
  eventDate       DateTime?
  guestCount      Int?
  eventType       String?
  venue           String?
  estimatedBudget Decimal?          @db.Decimal(12, 2)
  notes           String?
  nextAction      String?
  nextActionDate  DateTime?
  lostReason      String?
  assignedToId    String?
  assignedTo      TenantUser?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  activities      EnquiryActivity[]
  quotations      Quotation[]
  bookings        Booking[]
  communicationLogs CommunicationLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, eventDate])
}

model EnquiryActivity {
  id         String       @id @default(uuid())
  enquiryId  String
  enquiry    Enquiry      @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type       ActivityType @default(note)
  content    String
  authorId   String?
  authorName String?
  createdAt  DateTime     @default(now())

  @@index([enquiryId, createdAt])
}

// --- CAT-001: Food Catalogue and Catalogue Import ---

enum PricingUnit {
  per_person
  per_plate
  per_kg
  per_tray
  per_piece
  per_liter
  fixed
}

enum CatalogueImportStatus {
  pending
  completed
  failed
  partially_failed
}

model CatalogueItem {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  category     String      @default("main")
  pricingUnit  PricingUnit @default(per_person)
  costPrice    Decimal?    @db.Decimal(10, 2)
  sellingPrice Decimal     @db.Decimal(10, 2)
  dietaryTags  String[]    @default([])
  minQuantity  Int?
  isArchived   Boolean     @default(false)
  images       CatalogueItemImage[]
  menuItems    MenuItem[]
  recipeItems  RecipeItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isArchived])
  @@index([tenantId, name])
}

model CatalogueImportJob {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status         CatalogueImportStatus @default(pending)
  filename       String?
  totalRows      Int                   @default(0)
  successfulRows Int                   @default(0)
  failedRows     Int                   @default(0)
  errors         Json?                 @default("[]")
  importedById   String?
  importedBy     TenantUser?           @relation(fields: [importedById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model CatalogueItemImage {
  id        String        @id @default(uuid())
  itemId    String
  item      CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isPrimary Boolean       @default(false)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([itemId, isPrimary])
}

// --- MEN-001: Menu Builder ---

enum MenuStatus {
  draft
  active
  archived
}

model Menu {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  serviceStyle String?     @default("buffet")
  status       MenuStatus  @default(active)
  minGuests    Int?
  notes        String?
  items        MenuItem[]
  costSheets   CostSheet[]
  quotationRevisions QuotationRevision[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model MenuItem {
  id              String         @id @default(uuid())
  menuId          String
  menu            Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  section         String         @default("General")
  name            String
  description     String?
  quantity        Decimal        @default(1.0) @db.Decimal(10, 2)
  unitPrice       Decimal        @default(0.0) @db.Decimal(10, 2)
  costPrice       Decimal?       @db.Decimal(10, 2)
  dietaryTags     String[]       @default([])
  sortOrder       Int            @default(0)
  servingNotes    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([menuId])
  @@index([menuId, sortOrder])
  @@index([catalogueItemId])
}

// --- CST-001: Costing Engine & Recipes ---

model Recipe {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  category        String?      @default("general")
  yield           Decimal      @default(1.0) @db.Decimal(10, 2)
  yieldUnit       String       @default("portion")
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  notes           String?
  targetMargin    Decimal?     @db.Decimal(5, 2)
  isArchived      Boolean      @default(false)
  items           RecipeItem[]
  costSheets      CostSheet[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isArchived])
  @@index([tenantId, name])
}

model RecipeItem {
  id              String         @id @default(uuid())
  recipeId        String
  recipe          Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  name            String
  quantity        Decimal        @default(1.0) @db.Decimal(10, 3)
  unit            String         @default("kg")
  unitCost        Decimal        @default(0.0) @db.Decimal(10, 2)
  totalCost       Decimal        @default(0.0) @db.Decimal(10, 2)
  notes           String?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([recipeId])
  @@index([catalogueItemId])
}

enum CostSheetStatus {
  draft
  active
  archived
}

enum CostSheetItemType {
  ingredient
  recipe
  labor
  overhead
  other
}

model CostSheet {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  status              CostSheetStatus @default(draft)
  menuId              String?
  menu                Menu?           @relation(fields: [menuId], references: [id], onDelete: SetNull)
  recipeId            String?
  recipe              Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  servings            Decimal         @default(1.0) @db.Decimal(10, 2)
  ingredientCost      Decimal         @default(0.0) @db.Decimal(12, 2)
  laborCost           Decimal         @default(0.0) @db.Decimal(12, 2)
  overheadCost        Decimal         @default(0.0) @db.Decimal(12, 2)
  otherCost           Decimal         @default(0.0) @db.Decimal(12, 2)
  totalCost           Decimal         @default(0.0) @db.Decimal(12, 2)
  costPerServing      Decimal         @default(0.0) @db.Decimal(10, 2)
  targetMarginPercent Decimal         @default(30.0) @db.Decimal(5, 2)
  markupPercent       Decimal         @default(42.86) @db.Decimal(5, 2)
  suggestedPrice      Decimal         @default(0.0) @db.Decimal(12, 2)
  quotedPrice         Decimal         @default(0.0) @db.Decimal(12, 2)
  actualMarginPercent Decimal         @default(0.0) @db.Decimal(5, 2)
  notes               String?
  items               CostSheetItem[]
  quotationRevisions  QuotationRevision[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([menuId])
  @@index([recipeId])
}

model CostSheetItem {
  id              String            @id @default(uuid())
  costSheetId     String
  costSheet       CostSheet         @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  itemType        CostSheetItemType @default(ingredient)
  name            String
  quantity        Decimal           @default(1.0) @db.Decimal(10, 3)
  unit            String            @default("unit")
  unitCost        Decimal           @default(0.0) @db.Decimal(10, 2)
  totalCost       Decimal           @default(0.0) @db.Decimal(12, 2)
  sortOrder       Int               @default(0)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([costSheetId])
}

// --- QTN-001: Quotations and Revisions ---

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
  superseded
}

enum RevisionStatus {
  draft
  sent
  accepted
  rejected
  superseded
}

model Quotation {
  id                    String              @id @default(uuid())
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryId             String
  enquiry               Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  quotationNumber       String
  title                 String
  status                QuotationStatus     @default(draft)
  currentRevisionNumber Int                 @default(1)
  validUntil            DateTime?
  notes                 String?
  terms                 String?
  revisions             QuotationRevision[]
  bookings              Booking[]
  communicationLogs     CommunicationLog[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, enquiryId])
  @@index([quotationNumber])
}

model QuotationRevision {
  id                     String              @id @default(uuid())
  quotationId            String
  quotation              Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNumber         Int                 @default(1)
  status                 RevisionStatus      @default(draft)
  menuId                 String?
  menu                   Menu?               @relation(fields: [menuId], references: [id], onDelete: SetNull)
  costSheetId            String?
  costSheet              CostSheet?          @relation(fields: [costSheetId], references: [id], onDelete: SetNull)
  guestCount             Int?
  pricePerPerson         Decimal?            @db.Decimal(10, 2)
  subtotal               Decimal             @default(0.0) @db.Decimal(12, 2)
  taxPercent             Decimal             @default(0.0) @db.Decimal(5, 2)
  taxAmount              Decimal             @default(0.0) @db.Decimal(12, 2)
  discountAmount         Decimal             @default(0.0) @db.Decimal(12, 2)
  totalAmount            Decimal             @default(0.0) @db.Decimal(12, 2)
  estimatedCost          Decimal?            @db.Decimal(12, 2)
  estimatedMarginPercent Decimal?            @db.Decimal(5, 2)
  notes                  String?
  changeSummary          String?
  createdByUserId        String?
  items                  QuotationLineItem[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([quotationId])
  @@index([quotationId, revisionNumber])
  @@index([menuId])
  @@index([costSheetId])
}

model QuotationLineItem {
  id          String            @id @default(uuid())
  revisionId  String
  revision    QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String?           @default("Food & Beverage")
  quantity    Decimal           @default(1.0) @db.Decimal(10, 2)
  unit        String            @default("guest")
  unitPrice   Decimal           @default(0.0) @db.Decimal(10, 2)
  totalPrice  Decimal           @default(0.0) @db.Decimal(12, 2)
  unitCost    Decimal?          @db.Decimal(10, 2)
  totalCost   Decimal?          @db.Decimal(12, 2)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([revisionId])
}

// --- BKG-001: Booking Management ---

enum BookingStatus {
  draft
  confirmed
  in_progress
  completed
  cancelled
}

model Booking {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingNumber       String
  title               String
  status              BookingStatus     @default(draft)
  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotationId         String?
  quotation           Quotation?        @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  enquiryId           String?
  enquiry             Enquiry?          @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  serviceType         ServiceType       @default(event_catering)
  eventDate           DateTime
  guestCount          Int?
  venueName           String?
  venueAddress        String?
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  specialInstructions String?
  cancellationReason  String?
  totalAmount         Decimal           @default(0.0) @db.Decimal(12, 2)
  currency            String            @default("USD")
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  schedules           BookingSchedule[]
  communicationLogs   CommunicationLog[]
  invoices            Invoice[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, eventDate])
  @@index([bookingNumber])
  @@index([customerId])
  @@index([quotationId])
  @@index([enquiryId])
}

model BookingSchedule {
  id            String    @id @default(uuid())
  bookingId     String
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title         String
  scheduledDate DateTime
  startTime     String?
  endTime       String?
  description   String?
  location      String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bookingId])
  @@index([scheduledDate])
}

// --- COM-001: Communication Hub ---

enum CommunicationChannel {
  email
  sms
  whatsapp
  internal_note
}

enum CommunicationDirection {
  outbound
  inbound
}

enum CommunicationStatus {
  draft
  pending
  sent
  delivered
  failed
}

model CommunicationLog {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  enquiryId         String?
  enquiry           Enquiry?               @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  quotationId       String?
  quotation         Quotation?             @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  bookingId         String?
  booking           Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceId         String?
  invoice           Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  channel           CommunicationChannel   @default(email)
  direction         CommunicationDirection @default(outbound)
  status            CommunicationStatus    @default(sent)
  recipient         String
  sender            String?
  subject           String?
  content           String                 @db.Text
  metadata          Json?
  provider          String?                @default("mock")
  providerMessageId String?
  errorMessage      String?
  retryCount        Int                    @default(0)
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([enquiryId])
  @@index([quotationId])
  @@index([bookingId])
  @@index([invoiceId])
}

model CommunicationTemplate {
  id        String               @id @default(uuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  channel   CommunicationChannel @default(email)
  category  String               @default("general")
  subject   String?
  body      String               @db.Text
  isDefault Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
}


// --- FIN-001: Invoicing Module ---

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  void
}

enum InvoicePaymentMethod {
  bank_transfer
  cash
  credit_card
  cheque
  online
  other
}

model Invoice {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber     String
  status            InvoiceStatus      @default(draft)
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  title             String
  issueDate         DateTime
  dueDate           DateTime
  currency          String             @default("USD")
  subtotal          Decimal            @default(0.0) @db.Decimal(12, 2)
  taxRate           Decimal            @default(0.0) @db.Decimal(5, 2)
  taxAmount         Decimal            @default(0.0) @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0.0) @db.Decimal(12, 2)
  totalAmount       Decimal            @default(0.0) @db.Decimal(12, 2)
  paidAmount        Decimal            @default(0.0) @db.Decimal(12, 2)
  balanceDue        Decimal            @default(0.0) @db.Decimal(12, 2)
  notes             String?            @db.Text
  terms             String?            @db.Text
  issuedAt          DateTime?
  voidedAt          DateTime?
  voidReason        String?
  lineItems         InvoiceLineItem[]
  payments          InvoicePayment[]
  paymentAllocations PaymentAllocation[]
  communicationLogs CommunicationLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([invoiceNumber])
  @@index([customerId])
  @@index([bookingId])
  @@index([dueDate])
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1.0) @db.Decimal(10, 2)
  unitPrice   Decimal  @default(0.0) @db.Decimal(12, 2)
  totalAmount Decimal  @default(0.0) @db.Decimal(12, 2)
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model InvoicePayment {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal              @db.Decimal(12, 2)
  paymentDate   DateTime             @default(now())
  paymentMethod InvoicePaymentMethod @default(bank_transfer)
  reference     String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime             @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// --- FIN-002: Payments Module ---

enum PaymentStatus {
  unallocated
  partially_allocated
  allocated
  void
}

enum PaymentMethod {
  bank_transfer
  cash
  credit_card
  cheque
  online
  other
}

model Payment {
  id                String              @id @default(uuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentNumber     String
  customerId        String
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  paymentDate       DateTime            @default(now())
  paymentMethod     PaymentMethod       @default(bank_transfer)
  status            PaymentStatus       @default(unallocated)
  reference         String?
  notes             String?             @db.Text
  recordedBy        String?
  allocatedAmount   Decimal             @default(0.0) @db.Decimal(12, 2)
  unallocatedAmount Decimal             @default(0.0) @db.Decimal(12, 2)
  voidedAt          DateTime?
  voidReason        String?
  allocations       PaymentAllocation[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([paymentNumber])
  @@index([customerId])
  @@index([paymentDate])
}

model PaymentAllocation {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([paymentId])
  @@index([invoiceId])
}
