generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  onboarding
  active
  suspended
  archived
}

enum AuditLogScope {
  platform
  tenant
}

enum AuditLogOutcome {
  allowed
  denied
}

model Tenant {
  id          String          @id @default(uuid())
  slug        String          @unique
  displayName String
  status      TenantStatus    @default(onboarding)
  settings    TenantSettings?
  users       TenantUser[]
  invitations UserInvitation[]
  customers   Customer[]
  enquiries   Enquiry[]
  catalogueItems CatalogueItem[]
  catalogueImports CatalogueImportJob[]
  menus       Menu[]
  auditLogs   AuditLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TenantSettings {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  timezone     String   @default("UTC")
  currencyCode String   @default("USD")
  locale       String   @default("en")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PlatformRole {
  super_admin
  platform_ops
}

enum TenantRole {
  owner
  admin
  manager
  staff
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  displayName  String
  role         PlatformRole @default(platform_ops)
  isActive     Boolean      @default(true)
  sessions     Session[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model TenantUser {
  id              String      @id @default(uuid())
  email           String
  passwordHash    String
  displayName     String
  role            TenantRole  @default(staff)
  isActive        Boolean     @default(true)
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions        Session[]
  assignedEnquiries Enquiry[]
  catalogueImports CatalogueImportJob[]
  invitedBy       String?
  resetToken      String?     @unique
  resetTokenExpiry DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([email, tenantId])
  @@index([tenantId])
}

model UserInvitation {
  id        String           @id @default(uuid())
  email     String
  token     String           @unique
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      TenantRole       @default(staff)
  status    InvitationStatus @default(pending)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
  @@index([token])
}

model Session {
  id             String        @id @default(uuid())
  refreshToken   String        @unique
  scope          AuditLogScope
  platformUserId String?
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tenantUserId   String?
  tenantUser     TenantUser?   @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  tenantId       String?
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  @@index([platformUserId])
  @@index([tenantUserId])
  @@index([expiresAt])
}

model AuditLog {
  id        String          @id @default(uuid())
  scope     AuditLogScope
  outcome   AuditLogOutcome
  tenantId  String?
  action    String
  actorType String
  reason    String?
  metadata  Json?
  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([scope, tenantId, createdAt])
}

// --- CRM-001: Customer Management ---

model Customer {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean           @default(true)
  contacts    CustomerContact[]
  enquiries   Enquiry[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, email])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}


// --- CRM-002: Enquiry Management ---

enum EnquiryStatus {
  new
  qualified
  proposal_sent
  converted
  lost
  cancelled
}

enum ServiceType {
  event_catering
  daily_meals
  other
}

enum ActivityType {
  note
  call
  email
  meeting
  status_change
}

model Enquiry {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title           String
  status          EnquiryStatus     @default(new)
  serviceType     ServiceType       @default(event_catering)
  eventDate       DateTime?
  guestCount      Int?
  eventType       String?
  venue           String?
  estimatedBudget Decimal?          @db.Decimal(12, 2)
  notes           String?
  nextAction      String?
  nextActionDate  DateTime?
  lostReason      String?
  assignedToId    String?
  assignedTo      TenantUser?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  activities      EnquiryActivity[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, eventDate])
}

model EnquiryActivity {
  id         String       @id @default(uuid())
  enquiryId  String
  enquiry    Enquiry      @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type       ActivityType @default(note)
  content    String
  authorId   String?
  authorName String?
  createdAt  DateTime     @default(now())

  @@index([enquiryId, createdAt])
}

// --- CAT-001: Food Catalogue and Catalogue Import ---

enum PricingUnit {
  per_person
  per_plate
  per_kg
  per_tray
  per_piece
  per_liter
  fixed
}

enum CatalogueImportStatus {
  pending
  completed
  failed
  partially_failed
}

model CatalogueItem {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  category     String      @default("main")
  pricingUnit  PricingUnit @default(per_person)
  costPrice    Decimal?    @db.Decimal(10, 2)
  sellingPrice Decimal     @db.Decimal(10, 2)
  dietaryTags  String[]    @default([])
  minQuantity  Int?
  isArchived   Boolean     @default(false)
  images       CatalogueItemImage[]
  menuItems    MenuItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isArchived])
  @@index([tenantId, name])
}

model CatalogueImportJob {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status         CatalogueImportStatus @default(pending)
  filename       String?
  totalRows      Int                   @default(0)
  successfulRows Int                   @default(0)
  failedRows     Int                   @default(0)
  errors         Json?                 @default("[]")
  importedById   String?
  importedBy     TenantUser?           @relation(fields: [importedById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model CatalogueItemImage {
  id        String        @id @default(uuid())
  itemId    String
  item      CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isPrimary Boolean       @default(false)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([itemId, isPrimary])
}

// --- MEN-001: Menu Builder ---

enum MenuStatus {
  draft
  active
  archived
}

model Menu {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  serviceStyle String?     @default("buffet")
  status       MenuStatus  @default(active)
  minGuests    Int?
  notes        String?
  items        MenuItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model MenuItem {
  id              String         @id @default(uuid())
  menuId          String
  menu            Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  section         String         @default("General")
  name            String
  description     String?
  quantity        Decimal        @default(1.0) @db.Decimal(10, 2)
  unitPrice       Decimal        @default(0.0) @db.Decimal(10, 2)
  costPrice       Decimal?       @db.Decimal(10, 2)
  dietaryTags     String[]       @default([])
  sortOrder       Int            @default(0)
  servingNotes    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([menuId])
  @@index([menuId, sortOrder])
  @@index([catalogueItemId])
}
